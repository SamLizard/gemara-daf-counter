{
  "name": "gemara-daf-counter",
  "version": "1.0.0",
  "private": true,
  "description": "Measures how much of each page of the Vilna Shas is Gemara, Rashi, Tosafot and other commentary.",
  "type": "module",
  "scripts": {
    "build": "node src/build.mjs",
    "compare": "node src/compare-metrics.mjs",
    "test": "node --test src/*.test.mjs research/*.test.mjs",
    "measure:shas": "node src/measure-shas.mjs",
    "export:shas": "node src/shas-export.mjs",
    "export:front": "node src/export-front.mjs",
    "deploy": "npm --prefix front run deploy",
    "review:problems": "node src/problem-review.mjs",
    "research:renderer": "node research/renderer.mjs",
    "research:pdf": "node research/pdf.mjs",
    "research:inspect-pdf": "node research/inspect-pdf.mjs",
    "research:compare-text": "node research/compare-text.mjs",
    "research:review": "node research/review.mjs",
    "research:fetch-pages": "node research/fetch-pages.mjs",
    "research:review-corpus": "node research/corpus-review.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "daf-renderer": "1.1.4",
    "playwright-core": "1.56.1"
  }
}
